# ==============================
# Aurelytix Environment Variables
# ==============================

# Application
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aurelytix_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Application
APP_NAME=Aurelytix
APP_VERSION=1.0.0